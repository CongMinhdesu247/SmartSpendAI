FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SMARTSPEND_CLOUD=1
WORKDIR /app
COPY requirements/homeserver.lock.txt ./requirements/homeserver.lock.txt
RUN pip install --no-cache-dir -r requirements/homeserver.lock.txt \
    && useradd --create-home --uid 10001 smartspend
COPY --chown=smartspend:smartspend backend ./backend
COPY --chown=smartspend:smartspend frontend ./frontend
COPY --chown=smartspend:smartspend scripts/homeserver ./scripts/homeserver
USER smartspend
EXPOSE 8000
# No forwarded client headers are trusted: the published port is loopback-only.
CMD ["uvicorn", "backend.api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers"]
