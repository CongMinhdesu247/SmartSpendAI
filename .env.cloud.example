SMARTSPEND_CLOUD=1
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
GEMINI_API_KEY=YOUR_KEY
# Optional: set one model ID for every account. Empty keeps the existing fallback list.
GEMINI_MODEL=
SMARTSPEND_PASSWORD_HASH=GENERATED_ARGON2_HASH
SMARTSPEND_SESSION_SECRET=GENERATED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Render supplies RENDER_EXTERNAL_URL automatically.
# Other providers: SMARTSPEND_PUBLIC_URL=https://your-app.example.com
