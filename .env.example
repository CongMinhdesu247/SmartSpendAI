# Local Server / Home Server production configuration (.env).
# Generate private secrets safely using scripts/homeserver/configure.py.
SMARTSPEND_COMPOSE_PROJECT=smartspend-hp
SMARTSPEND_HTTP_PORT=8092
SMARTSPEND_IMAGE_TAG=local
SMARTSPEND_DB_PASSWORD=
SMARTSPEND_DB_ADMIN_PASSWORD=
SMARTSPEND_PASSWORD_HASH=
SMARTSPEND_SESSION_SECRET=
# Keep 0 for personal use; set SMARTSPEND_INVITE_CODE to share with family members.
SMARTSPEND_ALLOW_REGISTRATION=0
SMARTSPEND_INVITE_CODE=
# Replace with the actual HTTPS origin, without trailing path.
SMARTSPEND_PUBLIC_URL=https://replace-me.example.com
# Optional comma-separated extra Host headers (e.g. 192.168.1.50:8092,100.95.33.63:8092)
SMARTSPEND_ALLOWED_HOSTS=
# Set 1 when behind Reverse Proxy (Nginx/Caddy) or Cloudflare Tunnel on Local Server
SMARTSPEND_TRUST_PROXY=1
# Header resolution mode: auto (X-Real-IP then CF-Connecting-IP) | x-real-ip | cf-connecting-ip
SMARTSPEND_TRUSTED_HEADER=auto
GEMINI_API_KEY=
GEMINI_MODEL=
